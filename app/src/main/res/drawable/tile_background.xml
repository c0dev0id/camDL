<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_pressed" />
            <corners android:radius="16dp" />
            <stroke android:width="4dp" android:color="@color/tile_focused" />
        </shape>
    </item>
    <!-- Multi-select in the media grid reuses the focused treatment, so a picked tile and
         a D-pad focused tile read the same way they do in motoLauncher. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_default" />
            <corners android:radius="16dp" />
            <stroke android:width="6dp" android:color="@color/tile_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_default" />
            <corners android:radius="16dp" />
            <stroke android:width="6dp" android:color="@color/tile_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_default" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/surface" />
        </shape>
    </item>
</selector>
